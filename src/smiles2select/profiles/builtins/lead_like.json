{
  "id": "lead_like",
  "name": "Lead-like",
  "short_name": "LeadLike",
  "category": "lead_space",
  "version": "1.0.0",
  "logp_method": "rdkit_wlogp (Wildman-Crippen)",
  "reference": "10.1021/ci000403i",
  "notes": "Chemical space: lead-like. Purpose: selecting starting points for optimisation, i.e. structures smaller and less lipophilic than a finished drug, leaving room for molecular growth. Present this separately from the oral-drug filters.",
  "pass_policy": {
    "type": "all_rules"
  },
  "rules": [
    {
      "id": "ll_mw_min",
      "descriptor": "mol_wt",
      "operator": ">=",
      "threshold": 250,
      "severity": "hard",
      "failure_code": "LL_MW_LOW",
      "label": "Molecular weight"
    },
    {
      "id": "ll_mw_max",
      "descriptor": "mol_wt",
      "operator": "<=",
      "threshold": 350,
      "severity": "hard",
      "failure_code": "LL_MW_HIGH",
      "label": "Molecular weight"
    },
    {
      "id": "ll_logp_max",
      "descriptor": "rdkit_wlogp",
      "operator": "<=",
      "threshold": 3.5,
      "severity": "hard",
      "failure_code": "LL_LOGP_HIGH",
      "label": "LogP"
    },
    {
      "id": "ll_rotb_max",
      "descriptor": "rotatable_bonds",
      "operator": "<=",
      "threshold": 7,
      "severity": "hard",
      "failure_code": "LL_ROTB_HIGH",
      "label": "Rotatable bonds"
    }
  ]
}
